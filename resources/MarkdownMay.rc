#include "resource.h"
#include <windows.h>
#pragma code_page(65001)

IDI_MARKDOWNMAY ICON "icons/MarkdownMay.ico"
IDI_MARKDOWN_DOCUMENT ICON "icons/MarkdownMay.documents.md.ico"
IDI_TEXT_DOCUMENT ICON "icons/MarkdownMay.documents.md.ico"
IDB_ABOUT_PORTRAIT BITMAP "about_portrait.bmp"

IDD_ABOUT DIALOG 0, 0, 330, 185
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于马冬梅"
BEGIN
    LTEXT "", IDC_ABOUT_PORTRAIT, 12, 12, 120, 120
    LTEXT "马冬梅（Markdown May）", -1, 145, 18, 170, 18
    LTEXT "轻量、免费、开源的 Windows 原生 Markdown 编辑器", -1, 145, 42, 170, 34
    CONTROL "", IDC_ABOUT_LINKS, "SysLink", WS_TABSTOP | WS_CHILD | WS_VISIBLE, 145, 86, 170, 34
    DEFPUSHBUTTON "确定", IDOK, 265, 155, 52, 18
END
